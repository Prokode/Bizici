# Runtime
NODE_ENV=production
PORT=8080
API_HOST=127.0.0.1
REQUIRE_DB_READY=true
CORS_ALLOWED_ORIGINS=https://admin-bizici.run.place,https://site-bizici.run.place

# MongoDB Atlas test database
MONGODB_URI=CHANGE_ME

# Application sessions and Clerk test instance
SESSION_SECRET=CHANGE_ME
CLERK_SECRET_KEY=CHANGE_ME
CLERK_PUBLISHABLE_KEY=CHANGE_ME

# Administration
ADMIN_JWT_SECRET=CHANGE_ME
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_PASSWORD=CHANGE_ME

# Optional: only required for AI photo analysis
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_INTEGRATIONS_OPENAI_API_KEY=CHANGE_ME

# Optional: only required for Expo push notifications
# EXPO_ACCESS_TOKEN=CHANGE_ME