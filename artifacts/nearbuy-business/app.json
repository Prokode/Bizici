{
  "expo": {
    "name": "iciBiz Pro",
    "slug": "nearbuy-business",
    "owner": "tksm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icibiz-icon.png",
    "scheme": "bizici-pro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icibiz-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bizici.pro"
    },
    "android": {
      "package": "com.bizici.pro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icibiz-adaptive.png",
        "backgroundColor": "#FFF8E9"
      }
    },
    "web": {
      "favicon": "./assets/images/icibiz-icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/828671c6-7f21-43ce-9d72-97ba1389ed16"
    },
    "extra": {
      "eas": {
        "projectId": "828671c6-7f21-43ce-9d72-97ba1389ed16"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez iciBiz Pro à accéder à votre caméra pour prendre des photos de produits."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autorisez iciBiz Pro à utiliser votre position pour définir l'emplacement précis de votre boutique."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez iciBiz Pro à accéder à vos photos pour sélectionner des images de produits."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icibiz-notification.png",
          "color": "#B94F35",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
