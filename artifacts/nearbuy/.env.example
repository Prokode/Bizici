# Required: API hostname only. Do not include https:// or a trailing slash.
EXPO_PUBLIC_DOMAIN=api-bizici.run.place

# Required: Clerk client-side publishable key.
# Never put CLERK_SECRET_KEY or another private credential in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Optional: Clerk proxy URL, only when the Clerk frontend API is routed through a proxy.
EXPO_PUBLIC_CLERK_PROXY_URL=

# Optional: Replit project ID used by the static Expo build metadata.
# Replit workflows provide REPL_ID automatically, so this is normally left empty.
EXPO_PUBLIC_REPL_ID=

# Never add EXPO_TOKEN, CLERK_SECRET_KEY, SESSION_SECRET, or database credentials here.