{
  "expo": {
    "name": "iciBiz",
    "slug": "nearbuy",
    "owner": "tksm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icibiz-icon.png",
    "scheme": "bizici",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icibiz-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bizici.app"
    },
    "android": {
      "package": "com.bizici.app",
      "adaptiveIcon": {
          "foregroundImage": "./assets/images/icibiz-adaptive.png",
          "backgroundColor": "#FFF8E9"
        },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDwj4quKlmNeW5ZnuNBF6GXJ837Tk4rAPk"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/icibiz-icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dcfb7f39-fc26-4b45-813f-07e4bdb377d3"
    },
    "extra": {
      "eas": {
        "projectId": "dcfb7f39-fc26-4b45-813f-07e4bdb377d3"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez iciBiz à accéder à votre caméra pour rechercher des produits par photo."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autorisez iciBiz à utiliser votre position pour vous montrer les boutiques autour de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez iciBiz à accéder à vos photos pour la recherche visuelle."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icibiz-notification.png",
          "color": "#B94F35",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
